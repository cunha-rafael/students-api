generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id     Int    @id @default(autoincrement())
  nome   String
  curso  String
}
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}